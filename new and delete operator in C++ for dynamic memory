//Program on new and delete operators in C++ for dynamic memeory
#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Enter number of students: ";
    cin >> n;

    if (n <= 0) {
        cout << "Number of students must be positive." << endl;
        return 0;
    }

    int *marks = new int[n];

    cout << "Enter marks of " << n << " students:" << endl;

    for (int i = 0; i < n; i++) {
        cout << "Student " << i + 1 << ": ";
        cin >> marks[i];
    }

    cout << "\nStudent Marks:" << endl;

    for (int i = 0; i < n; i++) {
        cout << "Student " << i + 1 << ": " << marks[i] << endl;
    }

    delete[] marks;
    marks = nullptr;

    cout << "Dynamic memory released successfully." << endl;

    return 0;
}
